# Copy this file to .env and fill in what you need. .env is git-ignored: never commit secrets.

# Shared secret for service-to-service (/internal/*) calls. Change it to any long random string.
INTERNAL_TOKEN=change-me-to-a-long-random-string

# Requests per minute per client IP at the gateway
RATE_LIMIT_PER_MINUTE=120

# How often the SLA watcher checks deadlines (seconds)
SLA_CHECK_SECONDS=60

# ---- AI triage + help assistant on Amazon Bedrock ----
# false = free keyword rules + knowledge-base answers (no AWS needed). true = Claude on Bedrock.
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5

# ---- Amazon SNS alerts (optional) ----
# Leave empty locally. On AWS, Terraform creates the topic and the deploy script fills this in.
SNS_TOPIC_ARN=
